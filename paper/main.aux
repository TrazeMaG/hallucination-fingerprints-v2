\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}The Peak-Depth Constant: Central Finding}{3}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Last-Layer Suppression in GPT-2~XL.} ``Paris'' peaks at 85.78\% probability at block~41 (relative depth $\ell ^*/L = 0.854$) before collapsing at the final layer block~48 ($\rho = 20.8\times $). The model encoded the correct answer; the final layer suppressed it.}}{3}{figure.caption.13}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:suppression}{{1}{3}{\textbf {Last-Layer Suppression in GPT-2~XL.} ``Paris'' peaks at 85.78\% probability at block~41 (relative depth $\ell ^*/L = 0.854$) before collapsing at the final layer block~48 ($\rho = 20.8\times $). The model encoded the correct answer; the final layer suppressed it}{figure.caption.13}{}}
\def\@LN@column{1}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Peak-depth constant is invariant to prompt structure (GPT-2~XL, 30 facts $\times $ 4 structures = 120 prompts).} \textit  {Left}: averaged layer-by-layer probability curves for all 4 structures converge to the same suppression point near layer~40 (dashed line = 0.83 depth constant). \textit  {Right}: suppression ratio $\rho $ distributions by structure. The peak-depth constant across structures ($0.771$--$0.830$, range = 0.059) is the most stable property of LLS. This structural invariance is the strongest evidence that LLS is a mechanistic property, not a prompt-format artefact.}}{4}{figure.caption.14}\protected@file@percent }
\newlabel{fig:structure}{{2}{4}{\textbf {Peak-depth constant is invariant to prompt structure (GPT-2~XL, 30 facts $\times $ 4 structures = 120 prompts).} \textit {Left}: averaged layer-by-layer probability curves for all 4 structures converge to the same suppression point near layer~40 (dashed line = 0.83 depth constant). \textit {Right}: suppression ratio $\rho $ distributions by structure. The peak-depth constant across structures ($0.771$--$0.830$, range = 0.059) is the most stable property of LLS. This structural invariance is the strongest evidence that LLS is a mechanistic property, not a prompt-format artefact}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Cross-Architecture Comparison: 12 Models}{4}{subsection.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Complete cross-model results across 12 models and 6 architecture families.} Upper block: strong-suppression family (global/hybrid attention, shaded red). Lower block: weak-suppression family (local/RoPE attention, shaded green). The Mistral~7B / LLaMA~3~8B pair (same parameter count $\approx $8B, same layer count = 32, highlighted in bold) provides a controlled architectural comparison at scale.}}{4}{table.caption.15}\protected@file@percent }
\newlabel{tab:models}{{1}{4}{\textbf {Complete cross-model results across 12 models and 6 architecture families.} Upper block: strong-suppression family (global/hybrid attention, shaded red). Lower block: weak-suppression family (local/RoPE attention, shaded green). The Mistral~7B / LLaMA~3~8B pair (same parameter count $\approx $8B, same layer count = 32, highlighted in bold) provides a controlled architectural comparison at scale}{table.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Causal Evidence via Activation Patching}{4}{subsection.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Two hallucination families across 12 models.} Global/hybrid attention models (red region) cluster at high $\rho $. Local/RoPE models (green region) cluster near $\rho \approx 1$. Suppression ratio predicts intervention effectiveness ($r=0.91$, $p<0.001$). The Mistral~7B / LLaMA~3~8B pair (circled) provides a controlled comparison at equal scale, isolating the architectural effect.}}{5}{figure.caption.16}\protected@file@percent }
\newlabel{fig:families}{{3}{5}{\textbf {Two hallucination families across 12 models.} Global/hybrid attention models (red region) cluster at high $\rho $. Local/RoPE models (green region) cluster near $\rho \approx 1$. Suppression ratio predicts intervention effectiveness ($r=0.91$, $p<0.001$). The Mistral~7B / LLaMA~3~8B pair (circled) provides a controlled comparison at equal scale, isolating the architectural effect}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Scaling laws within the GPT-2 family (124M--1.5B).} \textit  {Left}: suppression ratio $\rho $ increases monotonically with scale ($2.4\times $ to $20.8\times $). \textit  {Centre}: Type~2a rate increases (10\% to 50\%). \textit  {Right}: peak relative depth converges to $\approx 0.83$ across all four sizes.}}{5}{figure.caption.17}\protected@file@percent }
\newlabel{fig:scaling}{{4}{5}{\textbf {Scaling laws within the GPT-2 family (124M--1.5B).} \textit {Left}: suppression ratio $\rho $ increases monotonically with scale ($2.4\times $ to $20.8\times $). \textit {Centre}: Type~2a rate increases (10\% to 50\%). \textit {Right}: peak relative depth converges to $\approx 0.83$ across all four sizes}{figure.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Self-patching on GPT-2~XL.} Injecting peak-layer activations into the final layer restores correct predictions in all 8 tested cases. The Australia case (already correct) shows $\Delta p=+0.829$, demonstrating that even correct predictions are suppressed but survive because their signal exceeds the suppression magnitude.}}{5}{table.caption.18}\protected@file@percent }
\newlabel{tab:patching}{{2}{5}{\textbf {Self-patching on GPT-2~XL.} Injecting peak-layer activations into the final layer restores correct predictions in all 8 tested cases. The Australia case (already correct) shows $\Delta p=+0.829$, demonstrating that even correct predictions are suppressed but survive because their signal exceeds the suppression magnitude}{table.caption.18}{}}
