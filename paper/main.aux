\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Scaling Law in the GPT-2 Family}{3}{subsection.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Last-Layer Suppression in GPT-2~XL for the prompt \emph  {``The capital of France is''}. The correct answer ``Paris'' peaks at 85.78\% probability at block~41 before collapsing at the final layer ($\rho = 20.8\times $). The model \emph  {knew} the correct answer---the final layer suppressed it.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:suppression}{{1}{3}{Last-Layer Suppression in GPT-2~XL for the prompt \emph {``The capital of France is''}. The correct answer ``Paris'' peaks at 85.78\% probability at block~41 before collapsing at the final layer ($\rho = 20.8\times $). The model \emph {knew} the correct answer---the final layer suppressed it}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaling laws in the GPT-2 family across 124M--1.5B parameters. Left: suppression ratio increases monotonically ($2.4\times $ to $20.8\times $). Centre: Type~2a rate increases (10\% to 50\%). Right: peak factual depth converges to a universal constant $\approx 0.83$ regardless of scale.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:scaling}{{2}{4}{Scaling laws in the GPT-2 family across 124M--1.5B parameters. Left: suppression ratio increases monotonically ($2.4\times $ to $20.8\times $). Centre: Type~2a rate increases (10\% to 50\%). Right: peak factual depth converges to a universal constant $\approx 0.83$ regardless of scale}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces LLS scales with model size in the GPT-2 family. Suppression ratio and Type~2a rate increase monotonically; peak depth converges to $\approx 0.83$.}}{4}{table.1}\protected@file@percent }
\newlabel{tab:scaling}{{1}{4}{LLS scales with model size in the GPT-2 family. Suppression ratio and Type~2a rate increase monotonically; peak depth converges to $\approx 0.83$}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Two distinct hallucination families across 10 models and 5 architecture families. Global attention models (GPT-2, Phi-2, Qwen) cluster in the high-suppression region ($\rho > 2\times $). Local/rotary attention models (GPT-Neo, Pythia) cluster near $\rho \approx 1.0$ regardless of scale. Suppression ratio predicts intervention effectiveness ($r = 0.91$, $p < 0.001$).}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:families}{{3}{4}{Two distinct hallucination families across 10 models and 5 architecture families. Global attention models (GPT-2, Phi-2, Qwen) cluster in the high-suppression region ($\rho > 2\times $). Local/rotary attention models (GPT-Neo, Pythia) cluster near $\rho \approx 1.0$ regardless of scale. Suppression ratio predicts intervention effectiveness ($r = 0.91$, $p < 0.001$)}{figure.3}{}}
